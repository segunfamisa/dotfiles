# Select the nearest uv-created virtual environment for this Firefox workspace.
# The shared interpreter under ~/mozilla-source/.python is intentionally not
# activated directly; each workspace keeps its own installed packages.

_firefox_root="$HOME/mozilla-source/firefox"
_firefox_dir="$PWD"

while [[ "$_firefox_dir" == "$_firefox_root" || "$_firefox_dir" == "$_firefox_root"/* ]]; do
  if [[ -f "$_firefox_dir/.venv/bin/activate" ]]; then
    source "$_firefox_dir/.venv/bin/activate"
    break
  fi
  [[ "$_firefox_dir" == "$_firefox_root" ]] && break
  _firefox_dir="$(dirname "$_firefox_dir")"
done

unset _firefox_root _firefox_dir
